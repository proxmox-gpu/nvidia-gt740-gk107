# Host-specific settings for the GT 740 passthrough scripts.
# Copy to .env (git-ignored) and edit:  cp .env.example .env
# The file is sourced by bash: KEY=value, no spaces around '='.

# --- Target VM -------------------------------------------------------------
VMID=240
VM_NAME=gpu-gt740
CORES=8
MEMORY=16384                # MiB; pinned completely while a PCI device is passed through
DISK_SIZE=64                # GiB
STORAGE=local-lvm           # storage for VM disks (must support snapshots: lvm-thin, zfs, or dir with qcow2)
DISK_FORMAT=                # empty for lvm-thin/zfs/ceph; "qcow2" for directory storages
BRIDGE=vmbr0                # network bridge of the VM
TPM=0                       # 1 = add TPM 2.0 (not required by Windows Server 2022/2025)

# --- ISO images ------------------------------------------------------------
ISO_STORAGE=local           # storage with content type "iso"
WIN_ISO=                    # Windows Server ISO file name in ISO_STORAGE, e.g. windows-server-2025.iso

# virtio-win, pinned version
VIRTIO_VERSION=0.1.271
VIRTIO_ISO=virtio-win-0.1.271.iso
VIRTIO_URL=https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.271-1/virtio-win-0.1.271.iso
VIRTIO_SHA256=              # empty: script prints the hash on first download; paste it here after checking

# NVIDIA driver, pinned version (R470, last branch for Kepler)
NV_VERSION=475.14
NV_FILE=475.14-desktop-win10-win11-64bit-international-whql.exe
NV_URL=https://us.download.nvidia.com/Windows/475.14/475.14-desktop-win10-win11-64bit-international-whql.exe
NV_SHA256=d1e8401fa4b48ec1f3c4aa6dc1e0824a51634ec87ed9dc6ab49c5c6dbd9bac2e
NV_ISO=nvidia-475.14.iso
NV_LABEL=NV47514
NV_INSTALL_MODE=full        # full = whole package (-s -noreboot); driver-only = only Display.Driver (extracted on host with 7z)

# --- GPU (filled in by host/01-preflight.sh) -------------------------------
GPU=                        # PCI address without function, e.g. 0000:01:00
IDS=                        # vendor:device of all functions, e.g. 10de:0fc8,10de:0e1b
MAP=gt740                   # name of the PCI resource mapping

# --- Guest agent -----------------------------------------------------------
GUEST_DIR='C:\gpu-setup'    # working directory inside the guest
GUEST_ENCODING=auto         # decoding of guest output: auto | utf-8 | cp866
NODE=                       # PVE node name; empty = $(hostname -s)
